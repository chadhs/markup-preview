{
  "name": "markup-preview",
  "version": "0.8.0",
  "description": "A live Org-mode and Markdown file previewer for macOS and Linux",
  "author": "Chad Stovern",
  "license": "BSD-3-Clause",
  "repository": "github:chadhs/markup-preview",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "build": "vite build && node scripts/build-analysis.mjs",
    "test": "node --test test/*.test.js",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "check": "npm test && npm run build",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "pack": "npm run build && electron-builder --dir",
    "notices": "node scripts/notices.mjs",
    "icons": "node scripts/icons.mjs",
    "checksums": "node scripts/checksums.mjs",
    "postinstall": "patch-package --error-on-fail"
  },
  "build": {
    "appId": "com.chadhs.markup-preview",
    "productName": "Markup Preview",
    "files": [
      "dist/**/*",
      "!node_modules{,/**/*}",
      "electron/**/*",
      "examples/**/*",
      "LICENSE",
      "README.org",
      "THIRD-PARTY-NOTICES.org"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "org",
        "name": "Org document",
        "role": "Viewer",
        "mimeType": "text/org"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "icon": "build/icon.icns",
      "artifactName": "markup-preview-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "strictVerify": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Office",
      "executableName": "markup-preview",
      "desktop": {
        "entry": {
          "StartupWMClass": "markup-preview",
          "Name": "Markup Preview",
          "GenericName": "Markup document viewer",
          "Keywords": "org-mode;Markdown;Emacs;notes;outline;plain text;",
          "Terminal": "false"
        }
      },
      "icon": "build/icons",
      "syncDesktopName": true,
      "executableArgs": [],
      "mimeTypes": [
        "text/x-org",
        "text/markdown",
        "text/x-markdown"
      ],
      "description": "Read Org and Markdown files and follow changes as you save",
      "artifactName": "markup-preview-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "build/icons/256x256.png",
        "to": "icon.png"
      }
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "github-slugger": "2.0.0",
    "highlight.js": "11.12.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mermaid": "11.17.2",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "orga": "4.7.1",
    "smol-toml": "1.8.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "patch-package": "8.0.1",
    "vite": "^8.2.2"
  },
  "desktopName": "markup-preview.desktop",
  "overrides": {
    "text-kit": "4.5.1"
  }
}
